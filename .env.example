# =============================================================================
# Obscura - Public Environment Configuration Example
# Copy to .env and configure for your local environment
# =============================================================================

# Midnight Blockchain Network Configuration
MIDNIGHT_NETWORK=testnet-02
MIDNIGHT_NODE_URL=https://testnet.midnight.network
MIDNIGHT_PROOF_SERVER=http://localhost:6300
MIDNIGHT_INDEXER_URL=https://indexer.testnet.midnight.network

# Deployed Obscura Contract Address
OBSCURA_CONTRACT_ADDRESS=obscura_contract_addr_20260922_testnet_01
OBSCURA_DEFAULT_MIN_AGE=18
